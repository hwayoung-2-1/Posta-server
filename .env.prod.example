APP_TIMEZONE=Asia/Seoul

APP_PORT=8080
# Use 127.0.0.1 when HTTPS is terminated by a reverse proxy on the host.
APP_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5432
REDIS_PORT=6379

DB_NAME=hwayoung
DB_USER=hwayoung
DB_PASSWORD=change-me

JWT_SECRET=change-me-to-a-random-string-with-at-least-32-bytes

SPRING_ACTIVE_PROFILES=prod,ddl-validate

